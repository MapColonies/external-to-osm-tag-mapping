{
  "name": "external-to-osm-tag-mapping",
  "version": "1.8.1",
  "description": "map external tags to osm tags",
  "main": "./src/index.ts",
  "scripts": {
    "test:unit": "jest --config=./tests/configurations/unit/jest.config.js",
    "test:integration": "jest --config=./tests/configurations/integration/jest.config.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prelint": "npm run format",
    "prelint:fix": "npm run format:fix",
    "lint:fix": "eslint --fix .",
    "lint:openapi": "redocly lint openapi3.yaml",
    "test": "npm run test:unit && npm run test:integration",
    "prebuild": "npm run clean",
    "start:dev": "npm run build && cd dist && cross-env CONFIG_OFFLINE_MODE=true  node --enable-source-maps --import ./instrumentation.mjs ./index.js",
    "build": "tsc --project tsconfig.build.json  && npm run assets:copy",
    "start": "npm run build && cd dist && node ./index.js",
    "assets:copy": "copyfiles -f ./config/* ./dist/config && copyfiles -f ./openapi3.yaml ./dist/ && copyfiles ./package.json dist && copyfiles -f ./schemas.json ./dist/",
    "clean": "rimraf dist",
    "prepare": "node .husky/install.mjs"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/mapcolonies/external-to-osm-tag-mapping.git"
  },
  "author": {
    "name": "MapColonies",
    "email": "mapcolonies@gmail.com",
    "url": "https://github.com/MapColonies"
  },
  "license": "ISC",
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@map-colonies/cleanup-registry": "^1.1.0",
    "@map-colonies/config": "^3.0.0",
    "@map-colonies/error-express-handler": "^3.0.0",
    "@map-colonies/express-access-log-middleware": "^2.0.1",
    "@map-colonies/js-logger": "^1.0.1",
    "@map-colonies/openapi-express-viewer": "^5.0.0",
    "@map-colonies/schemas": "https://ghatmpstorage.blob.core.windows.net/npm-packages/schemas-281b8cea26bb7b20f7b5ca3ce2e382b83f1407bc.tgz",
    "@map-colonies/telemetry": "^10.0.1",
    "compression": "^1.8.1",
    "express-openapi-validator": "^5.6.2",
    "ioredis": "^5.9.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@map-colonies/commitlint-config": "^1.1.1",
    "@map-colonies/eslint-config": "^6.0.0",
    "@map-colonies/prettier-config": "0.0.1",
    "@redocly/cli": "^1.34.0",
    "@types/compression": "^1.7.2",
    "@types/config": "0.0.41",
    "@types/express": "^4.17.17",
    "@types/geojson": "^7946.0.8",
    "@types/jest": "^29.5.2",
    "@types/supertest": "^6.0.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-plugin-jest": "^28.11.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-create-mock-instance": "^2.0.0",
    "jest-html-reporters": "^3.1.4",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "type-fest": "^2.13.0",
    "typescript": "^5.1.3"
  }
}
