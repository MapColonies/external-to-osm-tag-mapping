{
  "openapiConfig": {
    "filePath": "SWAGGER_FILE_PATH"
  },
  "telemetry": {
    "serviceName": "TELEMETRY_SERVICE_NAME",
    "hostname": "TELEMETRY_HOST_NAME",
    "version": "TELEMETRY_SERVICE_VERSION",
    "logger": {
      "level": "LOG_LEVEL",
      "prettyPrint": {
        "__name": "LOG_PRETTY_PRINT_ENABLED",
        "__format": "boolean"
      }
    },
    "tracing": {
      "enabled": "TELEMETRY_TRACING_ENABLED",
      "url": "TELEMETRY_TRACING_URL"
    },
    "metrics": {
      "enabled": "TELEMETRY_METRICS_ENABLED",
      "url": "TELEMETRY_METRICS_URL",
      "interval": "TELEMETRY_METRICS_INTERVAL"
    }
  },
  "server": {
    "port": "SERVER_PORT",
    "request": {
      "payload": {
        "limit": "REQUEST_PAYLOAD_LIMIT"
      }
    },
    "response": {
      "compression": {
        "enabled": {
          "__name": "RESPONSE_COMPRESSION_ENABLED",
          "__format": "boolean"
        }
      }
    }
  },
  "schema": {
    "provider": "SCHEMA_PROVIDER",
    "filePath": "SCHEMA_FILE_PATH"
  },
  "db": {
    "redis": {
      "host": "DB_HOST",
      "port": {
        "__name": "DB_PORT",
        "__format": "number"
      },
      "dbIndex": {
        "__name": "REDIS_DB_INDEX",
        "__format": "number"
      },
      "username": "DB_USERNAME",
      "password": "DB_PASSWORD",
      "prefix": "REDIS_KEY_PREFIX",
      "connectTimeoutMs": {
        "__name": "REDIS_CONNECT_TIMEOUT",
        "__format": "number"
      },
      "tls": {
        "enabled": {
          "__name": "REDIS_ENABLE_TLS_AUTH",
          "__format": "boolean"
        }
      }
    }
  },
  "application": {
    "hashKey": {
      "value": "APP_HASH_KEY",
      "enabled": {
        "__name": "APP_HASH_KEY_ENABLED",
        "__format": "boolean"
      }
    }
  }
}
