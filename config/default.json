{
  "openapiConfig": {
    "filePath": "./openapi3.yaml",
    "basePath": "/docs",
    "rawPath": "/api",
    "uiPath": "/api"
  },
  "telemetry": {
    "metrics": {},
    "tracing": {
      "isEnabled": false
    },
    "shared": {},
    "logger": {
      "level": "info",
      "prettyPrint": false
    }
  },
  "server": {
    "port": 8080,
    "request": {
      "payload": {
        "limit": "1mb"
      }
    },
    "response": {
      "compression": {
        "enabled": true,
        "options": null
      }
    }
  },
  "schema": {
    "provider": "file",
    "filePath": "schemas.json"
  },
  "db": {
    "redis": {
      "host": "redisHost",
      "port": 6379,
      "username": "",
      "password": "",
      "dbIndex": 0,
      "prefix": "",
      "connectTimeoutMs": 5000,
      "tls": {
        "enabled": false
      }
    }
  },
  "application": {
    "hashKey": {
      "enabled": true,
      "value": ""
    }
  }
}
